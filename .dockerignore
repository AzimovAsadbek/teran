# Keeps the Docker build context small and free of secrets and local state.
# Images install their own dependencies and build from source.

# Secrets and local configuration (only the committed examples may enter a build).
**/.env
**/.env.*
!**/.env.example
.deploy.env
.deploy.env.*
.deploy.lock

# Dependencies and build output
**/node_modules
**/.next
**/dist
**/.nest-dev
**/*.tsbuildinfo
apps/api/src/generated
apps/web/next-env.d.ts

# Runtime data and test output
apps/api/storage
backups
**/coverage
e2e/test-results
e2e/playwright-report
e2e/blob-report
e2e/.auth
**/*.log

# Repository and editor metadata
.git
.github
.claude
.vscode
.idea
**/.DS_Store
docs
