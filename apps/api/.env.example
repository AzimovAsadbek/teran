# ─────────────────────────────────────────────────────────────────────────────
# TERAN API — example environment. Copy to apps/api/.env and adjust.
# Never commit real secrets. Every value below is a placeholder.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
# Interface to listen on. Keep 127.0.0.1 locally; the Docker image sets 0.0.0.0.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# PostgreSQL. docker compose publishes it on 127.0.0.1:5434 (see docker-compose.yml).
DATABASE_URL=postgresql://teran:teran_dev_password@127.0.0.1:5434/teran_refinement?schema=public
DATABASE_POOL_MAX=10

# Public origin of the storefront. Used for CORS, CSRF origin checks and links in e-mails.
WEB_ORIGIN=http://localhost:3000
# Optional extra allowed origins, comma separated (e.g. a staging admin host).
CORS_EXTRA_ORIGINS=
# Number of reverse proxies in front of the API (the Next.js rewrite locally, Nginx in production).
TRUST_PROXY_HOPS=1

# Server-side secret (min. 32 chars) used to derive guest order-status links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Shared with the web server (API_INTERNAL_KEY in apps/web/.env). Its cached server-side requests
# send it and skip per-IP rate limits, which would otherwise throttle every visitor at once.
INTERNAL_API_KEY=replace-with-a-long-random-string-at-least-32-chars

# Cookies. COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
STAFF_SESSION_TTL_HOURS=12
CART_TTL_DAYS=30

# Uploaded pictures (re-encoded to WebP) and films. Use a persistent volume in production.
UPLOADS_DIR=./storage/uploads
UPLOAD_MAX_BYTES=5242880
# Cloudflare R2 instead of UPLOADS_DIR (ADR-043): all five or none. R2_PUBLIC_URL is the bucket's
# public address (the storefront's UPLOADS_ORIGIN). Never commit real keys.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://media.example.com

# Storefront cache revalidation webhook (must match REVALIDATE_SECRET in apps/web/.env).
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Online ordering: adding to a cart, placing an order, starting a payment. Off unless true, so a
# store that takes orders by phone (storefront without NEXT_PUBLIC_SHOW_PRICES) cannot be ordered
# from through the API. Set it to true together with the storefront's NEXT_PUBLIC_SHOW_PRICES=true.
CHECKOUT_ENABLED=false

# Payments (docs/architecture/payments.md, docs/deployment/payment-provider-setup.md).
# Methods the store presents at checkout, in order: CASH_ON_DELIVERY, CLICK, PAYME, CARD. An online
# method is only selectable when it can be processed: in live mode with its provider credentials
# below (cards: never, no card gateway is integrated), in demo mode always (simulated, labelled).
PAYMENT_METHODS_ENABLED=CASH_ON_DELIVERY
# live (default): real providers only. demo: every online method is simulated, no provider is
# contacted, no money moves. Production refuses demo unless ALLOW_DEMO_PAYMENTS=true.
# For local development with online payments: PAYMENT_METHODS_ENABLED=CASH_ON_DELIVERY,CLICK,PAYME,CARD
# and PAYMENT_PROVIDER_MODE=demo.
PAYMENT_PROVIDER_MODE=live
ALLOW_DEMO_PAYMENTS=false
# Minutes an unpaid online order keeps its stock before it is cancelled automatically.
ONLINE_PAYMENT_WINDOW_MINUTES=30
# Payme Merchant API (both or neither). Never commit real values.
PAYME_MERCHANT_ID=
PAYME_KEY=
# PAYME_CHECKOUT_URL=https://checkout.paycom.uz   (sandbox: https://test.paycom.uz)
# PAYME_LOGIN=Paycom
# PAYME_CHECK_IP=true
# Click SHOP API (all three or none). Never commit real values.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# OpenAPI docs at /api/docs. Keep disabled in production unless access is restricted.
SWAGGER_ENABLED=true

# Outgoing e-mail (optional). Password-reset e-mails are disabled until SMTP is configured.
# In development MAIL_TRANSPORT=log prints e-mails to the API log instead of sending them.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Telegram channel announcements (docs/architecture/telegram.md). disabled (default): nothing is
# composed or sent. dry-run: posts are composed and recorded in the admin area but never sent (safe
# for testing). live: published products/articles with "announce" ticked are posted once to the
# channel. The bot must be an administrator of the channel with "Post messages" permission.
TELEGRAM_MODE=disabled
# From @BotFather. Server-side only: never put it in the web app or commit it.
# TELEGRAM_BOT_TOKEN=
# The channel: a public @username or the numeric id (-100…).
# TELEGRAM_CHANNEL_ID=
# Language of the posts (uz, ru or en).
# TELEGRAM_POST_LOCALE=uz

# The chat's AI assistant (ADR-055, docs/architecture/assistant.md). Without a key the chat keeps its
# quick answers and TERAN's channels; with one, Admin → Settings → AI assistant switches it on.
# The key comes from Google AI Studio (https://aistudio.google.com/apikey). Server-side only: never
# put it in the web app, a chat or a commit.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Answers per day for all visitors together (a ceiling on what the key can cost).
# ASSISTANT_DAILY_LIMIT=2000

# First administrator, created with `pnpm --filter @teran/api admin:create` (see docs). Keep empty in
# committed files; set only in the shell or secret store when running the command.
ADMIN_EMAIL=
ADMIN_PASSWORD=
