// TERAN data model. See docs/architecture/database.md for the reasoning behind these decisions.
//
// Conventions
// - Primary keys are UUIDv7 (time-ordered, index friendly, not guessable like serial ids).
// - Money is NUMERIC(12,2) with an explicit ISO-4217 currency column (UZS by default).
// - Quantities are integers. Invariants that Prisma cannot express (non-negative stock,
//   positive quantities, price ordering) are enforced with CHECK constraints in migrations.
// - Localised content lives in *Translation tables keyed by (entity, locale).
// - Orders snapshot every purchase-time value they depend on.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Locale {
  uz
  ru
  en
}

enum UserRole {
  CUSTOMER
  MANAGER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductFormat {
  LOOSE_LEAF
  TEA_BAGS
  PYRAMIDS
  GIFT_SET
  ACCESSORY
  /// None of the tea formats applies (honey, sweets, ceramics…): the storefront shows no format.
  OTHER
}

enum CaffeineLevel {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Payment lifecycle; transitions are enforced by the API (docs/architecture/payments.md).
enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
}

/// What the customer chose at checkout.
enum PaymentMethod {
  CASH_ON_DELIVERY
  CLICK
  PAYME
  /// Visa and other cards through a card gateway (none integrated yet; demo only).
  CARD
}

/// Who processes a payment. DEMO is the simulated adapter used for demonstrations: it never
/// contacts a provider and never moves money.
enum PaymentProvider {
  CASH
  DEMO
  CLICK
  PAYME
}

enum AttributeKind {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum RedirectEntity {
  CATEGORY
  PRODUCT
  COLLECTION
  ARTICLE
}

enum InventoryReason {
  INITIAL_STOCK
  RESTOCK
  MANUAL_ADJUSTMENT
  ORDER_PLACED
  ORDER_CANCELLED
  RETURN
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum BusinessType {
  CAFE_RESTAURANT
  HOTEL
  RETAIL
  DISTRIBUTOR
  CORPORATE
  OTHER
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  /// Taken off the site and out of the default admin lists, kept for the record.
  ARCHIVED
}

/// Photographs, films (landscape) and shorts (upright films, the home page's feed; ADR-059).
enum MediaKind {
  PHOTO
  VIDEO
  SHORT
}

/// Where an uploaded film is on its way to the site (ADR-062).
enum MediaVideoJobState {
  WAITING
  WORKING
  FAILED
}

/// What a Telegram channel post announces.
enum TelegramEntity {
  PRODUCT
  ARTICLE
}

/// Delivery state of a Telegram post (docs/architecture/telegram.md). SENDING marks a post whose
/// request is in flight; if the process stops before the answer is recorded, the post becomes
/// FAILED with an "unknown result" note instead of being sent again automatically.
enum TelegramPostStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// A product review shows at once (PUBLISHED); staff can take it off the site (HIDDEN).
enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

// ─── Identity & access ──────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// Always stored trimmed and lower-cased.
  email            String    @unique
  passwordHash     String
  role             UserRole  @default(CUSTOMER)
  firstName        String
  lastName         String?
  /// E.164 format, e.g. +998901234567.
  phone            String?
  locale           Locale    @default(uz)
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  carts               Cart[]
  orders              Order[]
  orderEvents         OrderStatusEvent[]
  inventoryMovements  InventoryMovement[]
  confirmedPayments   Payment[]
  auditLogs           AuditLog[]
  addresses           CustomerAddress[]
  reviews             ProductReview[]

  @@index([role])
}

/// A customer's saved delivery address. At most one per user is the default (partial unique
/// index in the migration); only the owner and staff can read it.
model CustomerAddress {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional name the customer gives it ("Home", "Office").
  label         String?
  recipientName String
  /// E.164, e.g. +998901234567.
  phone         String
  regionCode    String
  city          String
  addressLine   String
  landmark      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// SHA-256 of the opaque session token; the raw token only ever lives in the HttpOnly cookie.
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Catalogue ──────────────────────────────────────────────────────────────

model Category {
  id               String       @id @default(uuid(7)) @db.Uuid
  slug             String       @unique
  /// Two levels: top-level categories (Tea, Gift sets) and their subcategories (Green tea).
  parentId         String?      @db.Uuid
  parent           Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]   @relation("CategoryTree")
  position         Int          @default(0)
  isActive         Boolean      @default(true)
  /// Built-in illustration used when no photo is uploaded (e.g. "black", "green", "herbal").
  illustrationKey  String?
  /// Cover picture chosen in the admin area (cards, menus, the category page): WebP renditions at
  /// <imageKey>/<width>.webp; small renditions serve as the thumbnail. None: a neutral TERAN visual.
  imageKey         String?      @unique
  imageWidths      Int[]
  imageWidth       Int?
  imageHeight      Int?
  /// The cover is a cut-out (transparent background), shown standing free instead of cropped.
  imageTransparent Boolean      @default(false)
  /// The product type new products in this category start with (a subcategory without one uses
  /// its parent's). Only a default for the admin product form; each product keeps its own type.
  productTypeId    String?      @db.Uuid
  productType      ProductType? @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  translations CategoryTranslation[]
  products     Product[]

  @@index([isActive, position])
  @@index([parentId, isActive, position])
  @@index([productTypeId])
}

model CategoryTranslation {
  categoryId     String   @db.Uuid
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale         Locale
  name           String
  description    String?
  /// Optional editorial text on the category page; plain text, paragraphs separated by blank lines.
  body           String?
  seoTitle       String?
  seoDescription String?
  /// Alternative text of the cover picture (the name is read when it is empty).
  imageAlt       String?

  @@id([categoryId, locale])
}

model Collection {
  id               String   @id @default(uuid(7)) @db.Uuid
  slug             String   @unique
  position         Int      @default(0)
  isActive         Boolean  @default(true)
  illustrationKey  String?
  /// Cover picture chosen in the admin area, as for categories.
  imageKey         String?  @unique
  imageWidths      Int[]
  imageWidth       Int?
  imageHeight      Int?
  imageTransparent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  translations CollectionTranslation[]
  products     ProductCollection[]

  @@index([isActive, position])
}

model CollectionTranslation {
  collectionId   String     @db.Uuid
  collection     Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  locale         Locale
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?
  /// Alternative text of the cover picture (the name is read when it is empty).
  imageAlt       String?

  @@id([collectionId, locale])
}

model ProductCollection {
  collectionId String     @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String     @db.Uuid
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
}

model Product {
  id                 String         @id @default(uuid(7)) @db.Uuid
  slug               String         @unique
  status             ProductStatus  @default(DRAFT)
  categoryId         String         @db.Uuid
  category           Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Decides which attributes the product has. Optional: products without a type use only the
  /// common fields (every product created before product types existed starts that way).
  productTypeId      String?        @db.Uuid
  productType        ProductType?   @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  format             ProductFormat  @default(LOOSE_LEAF)
  isFeatured         Boolean        @default(false)
  /// Only set when the value is known for the product; never guessed.
  caffeineLevel      CaffeineLevel?
  brewTempCelsius    Int?
  /// Upper end when the pack gives a range ("80–90 °C"); null for a single temperature.
  brewTempMaxCelsius Int?
  brewTimeMinSeconds Int?
  brewTimeMaxSeconds Int?
  /// Grams of tea per 250 ml of water.
  brewAmountGrams    Decimal?       @db.Decimal(4, 1)
  /// Upper end when the pack gives a range ("3–5 g"); null for a single amount.
  brewAmountMaxGrams Decimal?       @db.Decimal(4, 1)
  /// Built-in artwork used for demo imagery when no photo is uploaded.
  illustrationKey    String?
  /// Announce the product on the Telegram channel once it is published (one post, ever).
  announceOnTelegram Boolean        @default(false)
  /// Lowest active variant price, denormalised for sorting and price filtering.
  /// Maintained by ProductPricing.refreshMinPrice whenever variants change.
  minPrice           Decimal?       @db.Decimal(12, 2)
  /// Published reviews' count and the sum of their stars, denormalised for lists (the average is
  /// sum / count). Maintained by ReviewsService whenever a review is saved, hidden or deleted.
  ratingCount        Int            @default(0)
  ratingSum          Int            @default(0)
  publishedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  translations    ProductTranslation[]
  variants        ProductVariant[]
  images          ProductImage[]
  collections     ProductCollection[]
  attributeValues ProductAttributeValue[]
  reviews         ProductReview[]

  @@index([status, categoryId])
  @@index([status, publishedAt])
  @@index([status, minPrice])
  @@index([categoryId])
  @@index([productTypeId])
}

/// A kind of product (tea, coffee, gift set…) and the attributes products of that kind have.
model ProductType {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stable identifier, e.g. "tea".
  key          String   @unique
  position     Int      @default(0)
  isActive     Boolean  @default(true)
  /// Products of this type have brewing guidance (amount, temperature, time) and a caffeine level;
  /// the admin product form offers those fields only then (or when a product already has them).
  brewingGuide Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  translations ProductTypeTranslation[]
  attributes   AttributeDefinition[]
  products     Product[]
  categories   Category[]
}

model ProductTypeTranslation {
  productTypeId String      @db.Uuid
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  locale        Locale
  name          String

  @@id([productTypeId, locale])
}

/// A typed characteristic of a product type (e.g. roast level, flavour profile, net weight).
model AttributeDefinition {
  id            String        @id @default(uuid(7)) @db.Uuid
  productTypeId String        @db.Uuid
  productType   ProductType   @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  /// Stable identifier within the type, used in filter URLs, e.g. "roast-level".
  key           String
  kind          AttributeKind
  /// Display unit for numbers, e.g. "g".
  unit          String?
  /// Required before a product of this type can be published.
  isRequired    Boolean       @default(false)
  /// Offered as a filter on category, collection and search pages.
  isFilterable  Boolean       @default(false)
  /// Included in the product's search text.
  isSearchable  Boolean       @default(false)
  /// Shown on the product page.
  isVisible     Boolean       @default(true)
  position      Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  translations AttributeDefinitionTranslation[]
  options      AttributeOption[]
  values       ProductAttributeValue[]

  @@unique([productTypeId, key])
  @@index([productTypeId, position])
}

model AttributeDefinitionTranslation {
  attributeId String              @db.Uuid
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  locale      Locale
  label       String
  hint        String?

  @@id([attributeId, locale])
}

/// A choice of a SELECT or MULTI_SELECT attribute.
model AttributeOption {
  id          String              @id @default(uuid(7)) @db.Uuid
  attributeId String              @db.Uuid
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  /// Stable identifier, used in filter URLs, e.g. "dark".
  key         String
  position    Int                 @default(0)

  translations AttributeOptionTranslation[]
  values       ProductAttributeValue[]

  @@unique([attributeId, key])
  @@index([attributeId, position])
}

model AttributeOptionTranslation {
  optionId String          @db.Uuid
  option   AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  locale   Locale
  label    String

  @@id([optionId, locale])
}

/// One value of one attribute for one product. SELECT and scalar kinds have one row per product and
/// attribute; MULTI_SELECT has one row per chosen option. Exactly the column for the attribute's
/// kind is set; the API validates values against the definition before writing.
model ProductAttributeValue {
  id           String              @id @default(uuid(7)) @db.Uuid
  productId    String              @db.Uuid
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Restrict: an attribute or option that products still use cannot be deleted by accident.
  attributeId  String              @db.Uuid
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  optionId     String?             @db.Uuid
  option       AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: Restrict)
  numberValue  Decimal?            @db.Decimal(14, 3)
  booleanValue Boolean?
  /// TEXT attributes: localised plain text { "uz": "…", "ru": "…", "en": "…" }, validated by the API.
  textValue    Json?

  @@unique([productId, attributeId, optionId])
  @@index([attributeId, optionId])
  @@index([attributeId, numberValue])
  @@index([attributeId, booleanValue])
}

/// Old slugs that must keep working after an entity is renamed: requests for them are redirected
/// permanently to the entity's current address.
model SlugRedirect {
  id        String         @id @default(uuid(7)) @db.Uuid
  entity    RedirectEntity
  fromSlug  String
  /// Id of the category, product or collection the old slug belonged to.
  toId      String         @db.Uuid
  createdAt DateTime       @default(now())

  @@unique([entity, fromSlug])
  @@index([entity, toId])
}

model ProductTranslation {
  productId        String  @db.Uuid
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           Locale
  name             String
  shortDescription String?
  description      String?
  ingredients      String?
  tastingNotes     String?
  /// Only filled in when the origin has been verified by TERAN.
  origin           String?
  seoTitle         String?
  seoDescription   String?
  /// Lower-cased, apostrophe-normalised text used for search (name + descriptions + ingredients).
  searchText       String

  @@id([productId, locale])
  @@index([locale])
  /// Trigram index for substring search (requires the pg_trgm extension, created in migration).
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ProductVariant {
  id                String   @id @default(uuid(7)) @db.Uuid
  productId         String   @db.Uuid
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String   @unique
  /// Net weight in grams (e.g. 100). Variant labels are generated from structured data per locale.
  weightGrams       Int?
  /// Number of tea bags / pyramids / items in the pack.
  unitCount         Int?
  price             Decimal  @db.Decimal(12, 2)
  compareAtPrice    Decimal? @db.Decimal(12, 2)
  currency          String   @default("UZS") @db.Char(3)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  /// Optional GTIN/EAN; only stored when it is a real assigned code.
  barcode           String?  @unique
  isActive          Boolean  @default(true)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([productId, isActive, position])
}

model ProductImage {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Storage prefix; files live at <storageKey>/<width>.webp.
  storageKey  String   @unique
  widths      Int[]
  width       Int
  height      Int
  /// Unused (never written); per-language alt text lives in ProductImageTranslation.
  altText     String?
  /// A cut-out: the background is transparent (detected on upload), so the product can stand
  /// free on the home page stage. Other images are photographs on their own background.
  transparent Boolean  @default(false)
  position    Int      @default(0)
  /// SHA-256 of the uploaded file: the same file is not stored twice for one product.
  contentHash String?
  /// A muted film looping over this picture, the picture being its first frame (set by the import
  /// script): <videoKey>/video.mp4 (or .webm). `videoFiles` names its other files: "card" — a
  /// smaller copy for product cards (card.mp4), "mask" — where the film moves (mask.png; the
  /// picture shows elsewhere).
  videoKey    String?
  videoType   String?
  videoWidth  Int?
  videoHeight Int?
  videoFiles  String[] @default([])
  createdAt   DateTime @default(now())

  translations ProductImageTranslation[]

  @@unique([productId, contentHash])
  @@index([productId, position])
}

/// Alternative text of a product image per language; without it the product's name is read.
model ProductImageTranslation {
  imageId String       @db.Uuid
  image   ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  locale  Locale
  altText String

  @@id([imageId, locale])
}

// ─── Shopping cart ──────────────────────────────────────────────────────────

/// A signed-in customer's rating of a product, 1 to 5 stars, with an optional comment (ADR-042).
/// One per customer and product: saving again replaces it. Deleted with the product or the account.
model ProductReview {
  id               String       @id @default(uuid(7)) @db.Uuid
  productId        String       @db.Uuid
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String       @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String?
  /// The language the comment was written in.
  locale           Locale
  /// The customer had a delivered order with this product when the review was saved.
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PUBLISHED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

model Cart {
  id        String     @id @default(uuid(7)) @db.Uuid
  /// SHA-256 of the opaque cart token stored in the HttpOnly cart cookie.
  tokenHash String     @unique
  userId    String?    @db.Uuid
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id        String         @id @default(uuid(7)) @db.Uuid
  cartId    String         @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ─── Delivery ───────────────────────────────────────────────────────────────

model DeliveryMethod {
  id              String   @id @default(uuid(7)) @db.Uuid
  code            String   @unique
  isActive        Boolean  @default(true)
  position        Int      @default(0)
  price           Decimal  @db.Decimal(12, 2)
  /// Order subtotal from which delivery becomes free; null = never free.
  freeFromAmount  Decimal? @db.Decimal(12, 2)
  currency        String   @default("UZS") @db.Char(3)
  /// Region codes this method serves; empty = every region.
  regionCodes     String[]
  /// False for pickup-style methods that do not need a street address.
  requiresAddress Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  translations DeliveryMethodTranslation[]
  orders       Order[]

  @@index([isActive, position])
}

model DeliveryMethodTranslation {
  deliveryMethodId String         @db.Uuid
  deliveryMethod   DeliveryMethod @relation(fields: [deliveryMethodId], references: [id], onDelete: Cascade)
  locale           Locale
  name             String
  description      String?
  /// Human-readable delivery time estimate, as configured by TERAN.
  estimate         String?

  @@id([deliveryMethodId, locale])
}

// ─── Orders & payments ──────────────────────────────────────────────────────

model Order {
  id                 String          @id @default(uuid(7)) @db.Uuid
  /// Public, non-sequential order number (e.g. TRN-7K4Q2M9X).
  number             String          @unique
  status             OrderStatus     @default(PENDING)
  paymentStatus      PaymentStatus   @default(PENDING)
  paymentMethod      PaymentMethod
  locale             Locale
  userId             String?         @db.Uuid
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName       String
  customerPhone      String
  customerEmail      String?
  deliveryMethodId   String?         @db.Uuid
  deliveryMethod     DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  deliveryMethodName String
  regionCode         String
  city               String
  addressLine        String?
  landmark           String?
  customerNote       String?
  currency           String          @default("UZS") @db.Char(3)
  subtotal           Decimal         @db.Decimal(12, 2)
  deliveryFee        Decimal         @db.Decimal(12, 2)
  discountTotal      Decimal         @default(0) @db.Decimal(12, 2)
  total              Decimal         @db.Decimal(12, 2)
  /// Client-generated key that makes order submission idempotent.
  idempotencyKey     String          @unique
  /// SHA-256 of the token in the guest order-status link.
  accessTokenHash    String
  cancelReason       String?
  confirmedAt        DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items    OrderItem[]
  events   OrderStatusEvent[]
  payments Payment[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([customerPhone])
  @@index([createdAt])
}

model OrderItem {
  id          String          @id @default(uuid(7)) @db.Uuid
  orderId     String          @db.Uuid
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?         @db.Uuid
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Purchase-time snapshot, independent of later catalogue edits.
  productName String
  productSlug String
  format      ProductFormat   @default(LOOSE_LEAF)
  sku         String
  weightGrams Int?
  unitCount   Int?
  unitPrice   Decimal         @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal         @db.Decimal(12, 2)

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusEvent {
  id            String         @id @default(uuid(7)) @db.Uuid
  orderId       String         @db.Uuid
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  paymentStatus PaymentStatus?
  note          String?
  actorUserId   String?        @db.Uuid
  actor         User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())

  @@index([orderId, createdAt])
}

/// One attempt to pay an order. An order can have several (a failed card attempt, then cash);
/// Order.paymentStatus mirrors the latest attempt. Card data never reaches this database.
model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  orderId           String          @db.Uuid
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  provider          PaymentProvider @default(CASH)
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("UZS") @db.Char(3)
  /// Transaction id from an online provider (unused for cash on delivery).
  providerReference String?
  /// SHA-256 of the secret in this attempt's return and demo-page links (online payments only).
  accessTokenHash   String?         @unique
  /// An unpaid online payment stops being payable at this time; the order is then cancelled and
  /// its stock released.
  expiresAt         DateTime?
  /// Short machine-readable reason for FAILED or CANCELLED, e.g. "DECLINED", "CUSTOMER_CANCELLED".
  failureCode       String?
  confirmedAt       DateTime?
  /// Staff member who recorded a manual confirmation (e.g. cash collected on delivery).
  confirmedById     String?         @db.Uuid
  confirmedBy       User?           @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  events            PaymentEvent[]
  paymeTransactions PaymeTransaction[]
  clickTransactions ClickTransaction[]

  @@unique([provider, providerReference])
  @@index([orderId, createdAt])
  @@index([status, expiresAt])
}

/// Every change of a payment's status, with where it came from (customer, provider callback,
/// staff, scheduled job, demo). Never contains card data or secrets.
model PaymentEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  paymentId   String         @db.Uuid
  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fromStatus  PaymentStatus?
  toStatus    PaymentStatus
  /// customer | provider | staff | system | demo
  source      String
  /// Provider method or reason, e.g. "PerformTransaction" or "EXPIRED".
  detail      String?
  actorUserId String?        @db.Uuid
  createdAt   DateTime       @default(now())

  @@index([paymentId, createdAt])
}

/// A transaction of the Payme Merchant API (JSON-RPC calls from Payme). Times are milliseconds since
/// the epoch, exactly as returned to Payme; repeated calls are answered from this row.
model PaymeTransaction {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Payme's transaction id (24 characters).
  paymeId     String   @unique
  paymentId   String   @db.Uuid
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// Amount in tiyin, as sent by Payme.
  amount      BigInt
  /// Payme's own creation time (the `time` parameter).
  paymeTime   BigInt
  createTime  BigInt
  performTime BigInt   @default(0)
  cancelTime  BigInt   @default(0)
  /// 1 created, 2 performed, -1 cancelled, -2 cancelled after it was performed (refund).
  state       Int
  /// Payme cancellation reason code (1–5, 10), when cancelled.
  reason      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([paymentId])
  @@index([paymeTime])
}

/// A payment of the Click SHOP API (Prepare and Complete calls from Click).
model ClickTransaction {
  /// The merchant_prepare_id (and merchant_confirm_id) answered to Click, which must be an integer.
  /// Only Click ever sees it.
  prepareId     Int      @id @default(autoincrement())
  clickTransId  BigInt   @unique
  clickPaydocId BigInt
  paymentId     String   @db.Uuid
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// Amount in sum, as sent by Click.
  amount        Decimal  @db.Decimal(12, 2)
  /// 0 prepared, 1 completed, -1 cancelled.
  state         Int
  /// Click's error code when Click reported the payment as failed.
  clickError    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([paymentId])
}

// ─── Inventory ledger ───────────────────────────────────────────────────────

model InventoryMovement {
  id            String          @id @default(uuid(7)) @db.Uuid
  variantId     String          @db.Uuid
  variant       ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta         Int
  quantityAfter Int
  reason        InventoryReason
  orderId       String?         @db.Uuid
  actorUserId   String?         @db.Uuid
  actor         User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime        @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

// ─── Inquiries & marketing ──────────────────────────────────────────────────

model ContactInquiry {
  id           String        @id @default(uuid(7)) @db.Uuid
  name         String
  email        String?
  phone        String?
  subject      String?
  message      String
  locale       Locale
  status       InquiryStatus @default(NEW)
  internalNote String?
  handledAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

model WholesaleInquiry {
  id            String        @id @default(uuid(7)) @db.Uuid
  companyName   String
  contactName   String
  phone         String
  email         String?
  businessType  BusinessType
  regionCode    String?
  city          String?
  monthlyVolume String?
  message       String?
  locale        Locale
  status        InquiryStatus @default(NEW)
  internalNote  String?
  handledAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id             String           @id @default(uuid(7)) @db.Uuid
  email          String           @unique
  locale         Locale
  status         NewsletterStatus @default(SUBSCRIBED)
  source         String?
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?

  @@index([status])
}

// ─── Content ────────────────────────────────────────────────────────────────

model SiteSetting {
  key         String   @id
  /// Shape is validated per key by the API (see SettingsService).
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

model Article {
  id                 String        @id @default(uuid(7)) @db.Uuid
  slug               String        @unique
  status             ArticleStatus @default(DRAFT)
  illustrationKey    String?
  /// Cover picture (list cards, the article page, social sharing): WebP renditions at
  /// <coverKey>/<width>.webp. Required before an article is published.
  coverKey           String?       @unique
  coverWidths        Int[]
  coverWidth         Int?
  coverHeight        Int?
  /// Shown first in the home page's journal section.
  isFeatured         Boolean       @default(false)
  /// Announce the article on the Telegram channel once it is published (one post, ever).
  announceOnTelegram Boolean       @default(false)
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  translations ArticleTranslation[]
  /// Photographs and films from the gallery shown with the article (reused, not uploaded again).
  media        ArticleMedia[]

  @@index([status, publishedAt])
  @@index([status, isFeatured, publishedAt])
}

/// A gallery item shown with an article, in the editor's order. Only published items appear on
/// the article page; deleting either side removes the link.
model ArticleMedia {
  articleId   String    @db.Uuid
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  mediaItemId String    @db.Uuid
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  position    Int       @default(0)

  @@id([articleId, mediaItemId])
  @@index([mediaItemId])
}

model ArticleTranslation {
  articleId      String  @db.Uuid
  article        Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String
  excerpt        String?
  /// Plain-text body; paragraphs are separated by blank lines (rendered without HTML).
  body           String
  seoTitle       String?
  seoDescription String?
  /// Alternative text of the cover picture (the title is read when it is empty).
  coverAlt       String?

  @@id([articleId, locale])
}

/// "Lavhalar": photographs and short films about TERAN, shown on the media page and (featured
/// ones) on the home page. Uses the article publication states.
model MediaItem {
  id                   String        @id @default(uuid(7)) @db.Uuid
  kind                 MediaKind
  status               ArticleStatus @default(DRAFT)
  isFeatured           Boolean       @default(false)
  position             Int           @default(0)
  /// The photograph, or the video's poster: WebP renditions at <imageKey>/<width>.webp.
  imageKey             String?       @unique
  imageWidths          Int[]
  imageWidth           Int?
  imageHeight          Int?
  /// Videos only: the file at <videoKey>/video.<mp4|webm>, as uploaded.
  videoKey             String?       @unique
  videoType            String?
  /// Bytes (a film of any size, ADR-061).
  videoBytes           BigInt?
  /// Videos only: the file has a sound track (read from it on upload); the feed offers its sound.
  videoHasAudio        Boolean       @default(false)
  videoDurationSeconds Int?
  /// Videos only: optional subtitles (WebVTT) at <captionsKey>/captions.vtt.
  captionsKey          String?       @unique
  publishedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  translations MediaItemTranslation[]
  articles     ArticleMedia[]
  videoJob     MediaVideoJob?

  @@index([status, position])
}

/// An uploaded film being made ready for the site (ADR-062). The finished upload waits on the
/// uploads volume (`.processing/<uploadId>.source`) until the API has read it and kept it as it
/// is, copied it into an MP4 or converted it; then the row goes. A refused one stays, with its
/// reason, until the next upload. One per item: a newer upload replaces it.
model MediaVideoJob {
  mediaItemId String             @id @db.Uuid
  mediaItem   MediaItem          @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  /// The upload whose file this is (its pieces' id, ADR-061).
  uploadId    String             @unique
  state       MediaVideoJobState @default(WAITING)
  /// A conversion under way: how far, 0–100.
  percent     Int?
  /// Why it was refused: a reason the admin area explains.
  reason      String?
  /// Take the item's cover from the film if it has none (the browser could not show the film).
  makePoster  Boolean            @default(false)
  /// The uploaded file's size, in bytes.
  bytes       BigInt
  /// Who uploaded it, for the audit record written when the film is kept.
  actorUserId String?            @db.Uuid
  ipAddress   String?
  createdAt   DateTime           @default(now())
  /// Touched while the work goes on: a WORKING row left untouched belongs to a stopped process.
  updatedAt   DateTime           @updatedAt

  @@index([state, createdAt])
}

model MediaItemTranslation {
  mediaItemId String    @db.Uuid
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  locale      Locale
  title       String
  caption     String?
  altText     String?

  @@id([mediaItemId, locale])
}

// ─── Telegram channel ───────────────────────────────────────────────────────

/// One announcement on the Telegram channel for a published product or article: created after the
/// publishing transaction commits, sent by the outbox processor, retried on request. Unique per
/// entity, so an item is never announced twice.
model TelegramPost {
  id            String             @id @default(uuid(7)) @db.Uuid
  entityType    TelegramEntity
  entityId      String             @db.Uuid
  status        TelegramPostStatus @default(PENDING)
  /// Sent while the channel ran in dry-run mode: composed and recorded, never delivered.
  dryRun        Boolean            @default(false)
  attempts      Int                @default(0)
  /// Short reason of the last failure, without secrets.
  lastError     String?
  /// Message ids returned by Telegram (a photo post, plus a text message when needed).
  messageIds    String[]
  /// The text as it was sent (or would have been, in dry-run mode).
  text          String?
  /// Storage key of the picture that was attached, if any.
  imageKey      String?
  /// Not retried automatically before this time (rate limits, back-off).
  nextAttemptAt DateTime?
  /// A sender holds the post until this time; an expired claim means the outcome is unknown.
  lockedUntil   DateTime?
  requestedById String?            @db.Uuid
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([entityType, entityId])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

// ─── Audit trail ────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Dotted action name, e.g. "product.update", "order.status", "inventory.adjust".
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}
