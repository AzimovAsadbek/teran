# TERAN storefront (Next.js). Copy to .env.local for development. Placeholders only — never commit
# real values. Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle at build time.

# Where the API is reachable from the web server. Used for server-side data loading and for the
# /api/v1/* and /uploads/* rewrites (resolved at build time, so set it before `next build`).
API_INTERNAL_URL=http://127.0.0.1:4000

# Must equal INTERNAL_API_KEY in apps/api/.env. Cached server-side loads send it so the API does not
# rate-limit the storefront as if it were one visitor. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_INTERNAL_KEY=replace-with-the-same-value-as-INTERNAL_API_KEY

# Must equal REVALIDATE_SECRET in apps/api/.env. Authorises the API's cache-revalidation webhook
# (POST /api/revalidate) after catalogue, content or settings changes.
REVALIDATE_SECRET=replace-with-the-same-value-as-REVALIDATE_SECRET

# Public origin used for canonical URLs, hreflang, sitemap and Open Graph (https in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Languages offered, comma separated. Uzbek (uz) is the default and always enabled.
NEXT_PUBLIC_ENABLED_LOCALES=uz,ru,en

# Shows the "demonstration catalogue" notices. Set to false once real TERAN products are loaded.
NEXT_PUBLIC_DEMO_CONTENT=true
