# TERAN edge proxy: HTTPS with automatic certificates, routing and edge hardening.
# Caddy is the only service published to the internet (docker-compose.prod.yml).
# See docs/deployment/production.md.
#
# If a load balancer or CDN sits in front of Caddy, trust its address ranges here and raise
# TRUST_PROXY_HOPS for the API by one, otherwise every visitor shares the proxy's IP:
#   {
#   	servers {
#   		trusted_proxies static 203.0.113.0/24
#   	}
#   }

{$SITE_ADDRESS} {
	encode zstd gzip

	# Server-to-server credentials are never accepted from the internet.
	request_header -X-Internal-Key

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# The cache-revalidation webhook is called by the API over the private network only.
	handle /api/revalidate* {
		error 404
	}

	# API calls and uploaded images go straight to the API: exactly one proxy hop, which is
	# what TRUST_PROXY_HOPS=1 expects. Everything else is the Next.js storefront.
	handle /api/v1/* {
		reverse_proxy api:4000
	}
	handle /uploads/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}

	# Access log on stdout. Order-status, password-reset and unsubscribe links carry bearer
	# tokens in the query string; they are removed before anything is written.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
				request>headers>Referer delete
			}
		}
	}
}
