# ─────────────────────────────────────────────────────────────────────────────
# TERAN production configuration for docker-compose.prod.yml, read by deploy.sh.
#
#   cp docker/production.env.example .env.production && chmod 600 .env.production
#
# The host ports are not set here: deploy.sh asks for them once and keeps them in .deploy.env.
#
# .env.production is git-ignored. Never commit it, paste it into tickets or chats, or bake it into
# an image. Every value below is a placeholder. Every secret must be unique; generate each one
# separately with:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'
# (URL-safe characters only: POSTGRES_PASSWORD is embedded in a connection URL.)
# See docs/deployment/production.md for what each value does and how to rotate it.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public origin, https and no trailing slash, e.g. https://teran.example. Used for
# canonical links, the sitemap, e-mails and the API's CORS and CSRF origin checks. The server's
# Nginx serves this host name and proxies it to the ports deploy.sh publishes on 127.0.0.1.
PUBLIC_ORIGIN=
# Other origins the browser may call the API from, comma separated, https (usually none).
CORS_EXTRA_ORIGINS=

# ── Secrets (at least 32 characters each) ──────────────────────────────────────
POSTGRES_PASSWORD=
# Signs guest order links and newsletter unsubscribe links. Rotating it invalidates unsubscribe
# links already sent; order links already issued keep working.
APP_SECRET=
# Lets the storefront's server-side requests skip per-visitor rate limits.
INTERNAL_API_KEY=
# Authorises the API's cache-revalidation calls to the storefront.
REVALIDATE_SECRET=

# ── Storefront (compiled into the web image: rebuild after changing) ───────────
ENABLED_LOCALES=uz,ru,en
# "true" shows demonstration notices and keeps search engines out (noindex, robots.txt). "false"
# for the real shop, once real TERAN products and texts are in place (the case since 2026-10-18).
DEMO_CONTENT=false
# Prices, the bag and online ordering. Keep SHOW_PRICES and CHECKOUT_ENABLED equal: "false" while
# TERAN takes orders by phone and messengers (ADR-027), "true" once prices are confirmed.
# (CHECKOUT_ENABLED is read by the API when it starts; no rebuild needed for it alone.)
SHOW_PRICES=false
CHECKOUT_ENABLED=false
# Links to the photo and film gallery (/media). The pages work either way.
SHOW_GALLERY=false

# ── Pictures and films ─────────────────────────────────────────────────────────
# Cloudflare R2 (ADR-043): all five, or none to keep files in the `uploads` volume instead.
# R2_PUBLIC_URL is the bucket's public address (a custom domain such as https://media.teran.example
# rather than the rate-limited r2.dev address); the bucket's CORS rules must allow PUBLIC_ORIGIN.
# Changing R2_PUBLIC_URL needs a web rebuild (it is allowed in the content security policy).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── E-mail (password-reset messages). "disabled" or "smtp" ─────────────────────
MAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ── Payments (docs/deployment/payment-provider-setup.md) ──────────────────────
# Used only with CHECKOUT_ENABLED=true. Cash on delivery only until a provider is set up and
# tested. Online methods: CLICK, PAYME (live credentials below). CARD stays unavailable: no card
# gateway is integrated.
PAYMENT_METHODS_ENABLED=CASH_ON_DELIVERY
# Keep "live" on a shop that takes real orders. "demo" simulates every online payment and is
# refused unless ALLOW_DEMO_PAYMENTS=true (only for a demonstration site with DEMO_CONTENT=true).
PAYMENT_PROVIDER_MODE=live
ALLOW_DEMO_PAYMENTS=false
ONLINE_PAYMENT_WINDOW_MINUTES=30
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ── Telegram channel announcements (docs/architecture/telegram.md) ─────────────
# disabled | dry-run (composed and recorded, never sent) | live (needs the token and channel).
# The bot must be an administrator of the channel with "Post messages" permission.
TELEGRAM_MODE=disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_POST_LOCALE=uz

# ── The chat's AI assistant (ADR-055, docs/architecture/assistant.md) ──────────
# A Gemini API key from Google AI Studio; empty: no assistant (the chat offers TERAN's channels).
# Switch it on in Admin → Settings → AI assistant. Answers per day are capped for all visitors.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_DAILY_LIMIT=2000

# ── Optional overrides ─────────────────────────────────────────────────────────
# POSTGRES_USER=teran
# POSTGRES_DB=teran
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Larger pictures also need a larger client_max_body_size in the server's Nginx.
# UPLOAD_MAX_BYTES=5242880
# One per proxy in front of the API: Nginx alone is 1; add one for a CDN in front of Nginx.
# TRUST_PROXY_HOPS=1
# PAYME_LOGIN=Paycom
# PAYME_CHECK_IP=true
# Image tag used for the locally built images (keep the previous one for a rollback).
# TERAN_VERSION=latest
