# ─────────────────────────────────────────────────────────────────────────────
# TERAN production configuration for docker-compose.prod.yml.
#
#   cp docker/production.env.example .env.production && chmod 600 .env.production
#
# .env.production is git-ignored. Never commit it, paste it into tickets or chats, or bake it into
# an image. Every secret must be unique; generate each one separately with:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'
# (URL-safe characters only: POSTGRES_PASSWORD is embedded in a connection URL.)
# See docs/deployment/production.md for what each value does and how to rotate it.
# ─────────────────────────────────────────────────────────────────────────────

# Host name(s) Caddy serves and requests HTTPS certificates for. DNS must already point at this
# server and ports 80 and 443 must be reachable. Several names: "teran.example, www.teran.example".
SITE_ADDRESS=

# Canonical public origin, https and no trailing slash, e.g. https://teran.example. Used for
# canonical links, the sitemap, e-mails and the API's CORS and CSRF origin checks.
PUBLIC_ORIGIN=

# ── Secrets (at least 32 characters each) ──────────────────────────────────────
POSTGRES_PASSWORD=
# Signs guest order links and newsletter unsubscribe links. Rotating it invalidates both.
APP_SECRET=
# Lets the storefront's server-side requests skip per-visitor rate limits.
INTERNAL_API_KEY=
# Authorises the API's cache-revalidation calls to the storefront.
REVALIDATE_SECRET=

# ── Storefront (compiled into the web image: rebuild after changing) ───────────
ENABLED_LOCALES=uz,ru,en
# Keep "true" while the demonstration catalogue is live: pages show notices and are not indexed
# by search engines. Set to "false" only once real TERAN products and texts are in place.
DEMO_CONTENT=true

# ── E-mail (password-reset messages). "disabled" or "smtp" ─────────────────────
MAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ── Optional overrides ─────────────────────────────────────────────────────────
# POSTGRES_USER=teran
# POSTGRES_DB=teran
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# UPLOAD_MAX_BYTES=5242880
# Extra proxies in front of Caddy (load balancer, CDN): add one per proxy and configure
# trusted_proxies in docker/caddy/Caddyfile.
# TRUST_PROXY_HOPS=1
# HTTP_PORT=80
# HTTPS_PORT=443
# Image tag used for the locally built images.
# TERAN_VERSION=latest
